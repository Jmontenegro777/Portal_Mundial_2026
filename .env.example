# Database (PostgreSQL / Neon)
# Pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/portal_mundial_2026?sslmode=require"

# Direct connection (used by Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/portal_mundial_2026?sslmode=require"

# NextAuth
AUTH_SECRET="your-secret-key-here-min-32-chars"
AUTH_URL="https://your-app.vercel.app"

